      <g transform="translate(425 110) rotate(22)"><use href="#ring"/><use href="#ring" transform="scale(1.13)"/><use href="#ring" transform="scale(1.28)"/><use href="#ring" transform="scale(1.45)"/><use href="#ring" transform="scale(1.64)"/></g>
